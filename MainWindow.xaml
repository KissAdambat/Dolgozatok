<Window x:Class="Dolgozatok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dolgozatok"
        mc:Ignorable="d"
        Title="Dolgozatok" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="lvDolgozatok" Grid.Row="0" Margin="0,0,0,25"
                  ItemsSource="{Binding}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="BorderBrush" Value="Black"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nev" Width="130"
                                    DisplayMemberBinding="{Binding Nev}"/>
                    <GridViewColumn Header="Eletkor" Width="70"
                                    DisplayMemberBinding="{Binding Eletkor}"/>
                    <GridViewColumn Header="Pontszam" Width="95"
                                    DisplayMemberBinding="{Binding Pontszam}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Név:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtNev" Width="235" Height="38"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="Életkor:" VerticalAlignment="Center" Margin="25,0,10,0"/>
            <TextBox x:Name="txtEletkor" Width="78" Height="38"
                     VerticalContentAlignment="Center"/>
            <TextBlock Text="Pontszám:" VerticalAlignment="Center" Margin="25,0,10,0"/>
            <TextBox x:Name="txtPontszam" Width="78" Height="38"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="btnHozzaadas" Content="Hozzáadás" Width="156" Height="46"
                    Click="BtnHozzaadas_Click"/>
            <Button x:Name="btnMentes" Content="Mentés" Width="156" Height="46"
                    Margin="15,0,0,0" Click="BtnMentes_Click"/>
        </StackPanel>
    </Grid>
</Window>
